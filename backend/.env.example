PORT=5001
MONGO_URI=replace-with-our-remote-mongodb-url
JWT_SECRET=replace-with-a-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origins for CORS (supports FRONTEND_URL and CORS_ORIGIN)
FRONTEND_URL=https://crm-app-frontend-pz1ru.ondigitalocean.app
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0 / OpenID Connect
# Create an OAuth client at https://console.cloud.google.com/apis/credentials.
# Must be the same client id the frontend uses as VITE_GOOGLE_CLIENT_ID: the
# server checks that a Google token was issued to this application before it
# will accept it as proof of identity, so signing in with Google does not work
# until this is set. Sign-up and password login are unaffected.
GOOGLE_CLIENT_ID=

# Sign-up email verification. The address must belong to a domain that
# receives mail, and where outbound port 25 is reachable the mailbox itself is
# confirmed over SMTP. Servers that give no clear answer let the sign-up
# through, so a real address is never rejected.
# EMAIL_VERIFICATION=off disables the check entirely.
# EMAIL_VERIFICATION_SMTP=off keeps the domain check but skips the SMTP probe.
EMAIL_VERIFICATION=on
EMAIL_VERIFICATION_SMTP=on
EMAIL_VERIFICATION_TIMEOUT_MS=5000
# Hostname and sender used when introducing ourselves to the mail server.
EMAIL_VERIFICATION_HELO=
EMAIL_VERIFICATION_FROM=

# ─── Outbound email (sign-up confirmation codes) ──────────────────────────────
# SMTP relay used to send verification codes. With these unset the sign-up
# confirmation step is skipped automatically, so local checkouts still work.
#
# For Gmail (smtp.gmail.com): SMTP_USER is the full address, and SMTP_PASS must
# be a 16-character App Password from Google Account -> Security -> 2-Step
# Verification -> App passwords, never the account password. Gmail also
# requires the sender to be that same address, which is what MAIL_FROM falls
# back to when left blank.
#
# Test the settings without signing up:  node scripts/checkMail.js
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email-address-with-2FA-enabled
SMTP_PASS=16-digit-APP-PASSWORD
# Defaults to SMTP_USER. Only set this if your provider allows a different
# sender address.
MAIL_FROM=

# on | off | auto (default). "auto" enables the confirmation step as soon as
# the SMTP settings above are filled in.
SIGNUP_EMAIL_CONFIRMATION=auto

# ─── Admin bootstrap (used only by: npm run seed:admin) ───────────────────────
# Run the seeder once to create the first Admin account. After logging in,
# delete or rotate ADMIN_PASSWORD from this file.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULLNAME=System Admin
ADMIN_COMPANY=YourCompany
