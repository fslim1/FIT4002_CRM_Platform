# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL for the backend API. Leave blank to use the Vite dev-server proxy.
VITE_API_URL=http://localhost:5001

# ─── Phone / WhatsApp ─────────────────────────────────────────────────────────
# Default country code used when normalising local phone numbers (starting with 0)
# into the international format required by WhatsApp click-to-chat links (wa.me).
# Digits only — no "+" prefix.
# Example: 60 = Malaysia, 65 = Singapore, 61 = Australia
VITE_DEFAULT_PHONE_COUNTRY_CODE=60

# ─── Google sign-in and Gmail linking ─────────────────────────────────────────
# OAuth client id from https://console.cloud.google.com/apis/credentials, the
# same client as GOOGLE_CLIENT_ID in backend/.env. Needed for "Continue with
# Google" and for linking Gmail. Sign-up works without it: the account is
# created and Gmail can be linked later from Settings.
VITE_GOOGLE_CLIENT_ID=same-as-the-one-in-backend-.env
