# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL for the backend API. Leave blank to use the Vite dev-server proxy.
VITE_API_URL=http://localhost:5001

# ─── Phone / WhatsApp ─────────────────────────────────────────────────────────
# Default country code used when normalising local phone numbers (starting with 0)
# into the international format required by WhatsApp click-to-chat links (wa.me).
# Digits only — no "+" prefix.
# Example: 60 = Malaysia, 65 = Singapore, 61 = Australia
VITE_DEFAULT_PHONE_COUNTRY_CODE=60
